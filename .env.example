# Basis-URL eures EXISTIERENDEN internen Ollama, ohne /api oder /v1/systemone.
# Leer lassen = Datenvorschau, keine Modellaufrufe.
OLLAMA_BASE_URL=

# Exakter Modellname aus `ollama list` auf eurem Server.
# josev-2b ist hier ein Beispiel für einen internen Alias.
JOSEV_MODEL=josev-2b
OLLAMA_API_KEY=

# Optionaler Vergleich: LLM_MODEL leer = nur Josev.
# Leere LLM_BASE_URL verwendet denselben Ollama wie Josev.
# LLM_PROVIDER: ollama (Standard) oder openai (offizielle OpenAI-API, Basis-URL https://api.openai.com).
# Bei openai ist LLM_API_KEY Pflicht; der Ollama-Schlüssel wird nie an OpenAI gesendet.
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Währung der Kostenanzeige: EUR oder USD. Preise und Stundensätze gelten in dieser Währung.
COST_CURRENCY=EUR

# Echte Tokenpreise je 1 Mio. Token (Eingabe und Ausgabe, beide nötig). Haben Vorrang vor dem Stundensatz.
# OpenAI gpt-6-luna (Standard): 0.10 / 0.50 USD, siehe https://developers.openai.com/api/docs/pricing
JOSEV_PRICE_INPUT_PER_MTOK=
JOSEV_PRICE_OUTPUT_PER_MTOK=
# Optionaler Hinweis, der neben dem Preis angezeigt wird (z. B. Quelle des Preises).
JOSEV_PRICE_NOTE=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Kosten in EUR je Stunde der jeweils bereitgestellten Ressource.
# Beispiel: 1.20; Dezimalpunkt verwenden. Leer = unbekannt, keine Kostenbehauptung.
# Grundlage: Laufzeit x Ressourcensatz. Keine Energie- oder Rechnungsdaten.
JOSEV_COST_PER_HOUR_EUR=
LLM_COST_PER_HOUR_EUR=

HOST=127.0.0.1
PORT=3000
REQUEST_TIMEOUT_MS=120000
MAX_CONCURRENCY=4
MODEL_KEEP_ALIVE=10m

# Docker-Port auf dem Host. Für euren internen Reverse Proxy ist localhost genug.
DEMO_BIND_ADDRESS=127.0.0.1
DEMO_PORT=3000
